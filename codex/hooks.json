{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "{{GUARD_COMMAND}}", "timeout": 30 }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "{{GUARD_COMMAND}}", "timeout": 120 }] },
      { "matcher": "apply_patch", "hooks": [{ "type": "command", "command": "{{GUARD_COMMAND}}", "timeout": 30 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "{{GUARD_COMMAND}}", "timeout": 3 }] }
    ]
  }
}
